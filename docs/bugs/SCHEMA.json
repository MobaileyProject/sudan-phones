{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketplace defect record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "severity", "status", "affected_files", "affected_endpoints", "root_cause", "fix_summary", "regression_test"],
  "properties": {
    "id": {"type": "string", "pattern": "^BUG-[0-9]{4}-[0-9]{3,}$"},
    "category": {"enum": ["auth", "db", "schema", "logic", "performance", "ui"]},
    "severity": {"enum": ["critical", "high", "medium", "low"]},
    "status": {"enum": ["reported", "in_progress", "resolved"]},
    "affected_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"}},
    "affected_endpoints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "root_cause": {"type": "string"},
    "fix_summary": {"type": "string"},
    "regression_test": {"type": "string"}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "resolved"}}, "required": ["status"]},
    "then": {
      "properties": {
        "affected_files": {"minItems": 1},
        "root_cause": {"minLength": 1},
        "fix_summary": {"minLength": 1},
        "regression_test": {"minLength": 1}
      }
    }
  }]
}
