# Copy OUTSIDE the checkout, chmod 600, then fill privately. Never commit real values.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_DEBUG=False
POSTGRES_DB=sudan_phones
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# TLS ingress must overwrite X-Forwarded-Proto and X-Forwarded-For.
DJANGO_TRUST_PROXY_SSL=False
TRUSTED_PROXY_COUNT=0
DJANGO_CSRF_TRUSTED_ORIGINS=
# Hosted HTTPS stays enabled. Local guest-only smoke can explicitly set False.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=0
PUBLIC_LISTING_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_DOMAIN=
# WhatsApp/email provider setup is deferred. Do not set an OTP bypass adapter.
